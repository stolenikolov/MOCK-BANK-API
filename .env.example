# --- server ---
PORT=4000

# --- database ---
# Local PostgreSQL 18 runs on 5433 here; docker-compose.yml uses 5432.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/mock_bank?schema=public"
# On Vercel: DATABASE_URL is Neon's pooled URL (add &pgbouncer=true) and
# DATABASE_URL_UNPOOLED the direct one, which the build uses for migrations.

# --- auth (every endpoint requires header: X-API-Key: <API_KEY>) ---
API_KEY="dev-mock-bank-key"

# --- webhooks back to BiznisMk ---
BIZNISMK_WEBHOOK_URL="http://localhost:3000/webhooks/bank"
WEBHOOK_SIGNING_SECRET="dev-webhook-secret"
WEBHOOK_TIMEOUT_MS=8000
# comma-separated backoff in ms for the 3 retries after the first attempt.
# On Vercel keep the whole ladder inside the 60s function limit, e.g. "1000,3000,8000".
WEBHOOK_RETRY_BACKOFF_MS="2000,10000,30000"

# Vercel only: the bearer token Vercel Cron sends to /webhooks/failed/replay.
# CRON_SECRET=""
