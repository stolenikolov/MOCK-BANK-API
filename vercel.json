{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "NODE_ENV=development npm ci",
  "buildCommand": "node scripts/vercel-build.js",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/webhooks/failed/replay", "schedule": "0 4 * * *" }]
}
